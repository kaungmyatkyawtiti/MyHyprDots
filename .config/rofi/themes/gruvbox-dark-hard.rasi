* {
    /* Gruvbox Dark Hard Palette */
    bg0: rgba(29, 32, 33, 0.92);  /* #1d2021 at 92% opacity */
    bg1: rgba(60, 56, 54, 0.92);  /* #3c3836 at 92% opacity */
    grey0: #928374;
    fg0: #ebdbb2;
    blue: #83a598;
    red: #fb4934;
    orange: #fe8019;
    green: #b8bb26;
    bgStatusline3: #665c54;
    
    /* Set globally transparent so opacity doesn't stack in nested elements */
    background-color: transparent;
}

window {
    height: 600;
    width: 600;
    border: 2;
    border-radius: 8;
    border-color: @bgStatusline3;
    background-color: @bg0;
}

mainbox {
    spacing: 0;
    children: [inputbar, message, listview];
}

inputbar {
    color: @fg0;
    padding: 12;
    background-color: transparent;
}

message {
    padding: 10;
    background-color: @grey0;
}

listview {
    padding: 8;
    border-radius: 0 0 10 10;
    border: 2 2 2 2;
    border-color: transparent;
    background-color: transparent;
    dynamic: false;
}

textbox {
    text-color: @fg0;
    background-color: inherit;
}

error-message {
    border: 20 20 20 20;
}

entry, prompt, case-indicator {
    text-color: inherit;
}

prompt {
    margin: 0 10 0 0;
}

element {
    padding: 5;
    vertical-align: 0.5;
    border-radius: 10;
    background-color: transparent;
}

element.selected.normal {
    background-color: @grey0;
}

element.alternate.normal {
    background-color: inherit;
}

element.normal.active, element.alternate.active {
    background-color: @orange;
}

element.selected.active {
    background-color: @green;
}

element.normal.urgent, element.alternate.urgent {
    background-color: @red;
}

element.selected.urgent {
    background-color: @blue;
}

element-text, element-icon {
    size: 25;
    margin: 0 10 0 0;
    vertical-align: 0.5;
    background-color: inherit;
    text-color: @fg0;
}

element-text .active, element-text .urgent {
    text-color: @bg0;
}
