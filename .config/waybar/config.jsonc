{
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 42,
  "border-radius": 25,
  "margin-top": 2,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/misc-expander",
    "group/stats",
    "hyprland/language",
    "group/control",
    "battery",
    "clock",
    "tray"
  ],
  "include": "~/.config/waybar/modules.jsonc"
}
