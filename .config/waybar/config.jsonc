{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 40,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/misc-expander",
    "cpu",
    "memory",
    "hyprland/language",
    "group/stats",
    "battery",
    "clock"
  ],
  "include": "~/.config/waybar/modules.jsonc"
}
